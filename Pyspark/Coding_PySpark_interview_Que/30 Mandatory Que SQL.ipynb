   "source": [
    "%sql\n",
    "WITH cte AS (\n",
    "    SELECT *,\n",
    "           ROW_NUMBER() OVER(PARTITION BY emp_id ORDER BY emp_id) AS rn\n",
    "    FROM Employees\n",
    ")\n",
    "DELETE FROM cte\n",
    "WHERE rn > 1;"
   ]
